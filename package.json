{
  "name": "pi-information-protecter",
  "version": "0.8.3",
  "description": "Sensitive Personal Information (SPI) Protecter — local reversible privacy redaction for Pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taills/pi-information-protecter.git"
  },
  "homepage": "https://github.com/taills/pi-information-protecter#readme",
  "bugs": {
    "url": "https://github.com/taills/pi-information-protecter/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "privacy",
    "redaction"
  ],
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/MIGRATION.md",
    "protecter.example.json",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.mjs"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0 <0.85.0 || >=0.85.1 <0.88.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  }
}
